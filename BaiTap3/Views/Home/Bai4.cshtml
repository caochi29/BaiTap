@{
    ViewBag.Title = "Bài 4 - TO-DO LIST";
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <title>TO-DO LIST</title>

    <style>

        body {
            font-family: Arial;
            background-color: white;
        }

        .container {
            width: 600px;
            margin: 50px auto;
        }

        .title {
            text-align: center;
            font-size: 28px;
            font-weight: bold;
            margin-bottom: 25px;
        }

        .input-area {
            display: flex;
            margin-bottom: 20px;
        }

        #congViec {
            flex: 1;
            padding: 10px;
            font-size: 16px;
        }

        #btnThem {
            padding: 10px 20px;
            margin-left: 5px;
            cursor: pointer;
        }

        ul {
            padding: 0;
            margin: 0;
            list-style-type: none;
        }

        li {
            padding: 12px;
            border: 1px solid #ddd;
            margin-bottom: 5px;
        }

        .daXong {
            text-decoration: line-through;
        }

        .btnXoa {
            float: right;
            cursor: pointer;
        }
    </style>

</head>

<body>

    <div class="container">

        <div class="title">
            TO-DO LIST
        </div>


        <div class="input-area">

            <input type="text"
                   id="congViec"
                   placeholder="Nhập công việc..." />

            <input type="button"
                   id="btnThem"
                   value="Thêm"
                   onclick="themCongViec()" />

        </div>


        <ul id="danhSachCongViec">
        </ul>

    </div>


    <script src="~/Scripts/Bai4.js"></script>

</body>
</html>