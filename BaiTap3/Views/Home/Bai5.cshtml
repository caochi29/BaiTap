@{
    ViewBag.Title = "Bài tập 5";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Progress Bar</title>

    <style>
        .container {
            width: 500px;
            margin: 50px auto;
            font-family: Arial;
        }

        .progress {
            width: 100%;
            height: 30px;
            border: 1px solid #000;
        }

        #progressBar {
            width: 0%;
            height: 30px;
            background-color: #4CAF50;
            color: white;
            text-align: center;
            line-height: 30px;
        }

        #btnStart {
            margin-top: 15px;
            padding: 5px 15px;
        }
    </style>
</head>

<body>

    <div class="container">

        <h3>BÀI TẬP 5: PROGRESS</h3>

        <div class="progress">
            <div id="progressBar">0%</div>
        </div>

        <input type="button"
               id="btnStart"
               value="Bắt đầu"
               onclick="batDau()" />

    </div>

    <script src="~/Scripts/Bai5.js"></script>

</body>
</html>